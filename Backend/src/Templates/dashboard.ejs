<!doctype html>
<html lang="es" data-bs-theme="light">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Panel de administración</title>
  <link rel="icon" href="/public/img/logo.jpg" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
  <link rel="stylesheet" href="/public/css/styles.css" />
</head>

<body data-page="dashboard">
  <%- include("nav") %>

  <main class="container py-4">
    <h1 class="h3 mb-4">Panel de administración</h1>
    <a href="/productos/alta" class="btn btn-primary mb-4">
      Agregar producto</a>
    <% const categorias = [ { nombre: "Zapatillas", productos: zapatillas }, 
    { nombre: "Camisetas", productos: camisetas }]; %>

    <% for (let categoria of categorias) { %>

    <section class="mb-5">
      <h2 class="h5 mb-3"><%= categoria.nombre %></h2>

      <div class="table-responsive">
        <table class="table table-striped align-middle">
          <thead>
            <tr class="table-primary">
              <th>ID</th>
              <th>Imagen</th>
              <th>Marca</th>
              <th>Modelo</th>
              <th>Talle</th>
              <th>Color</th>
              <th>Jugador</th>
              <th>Precio</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>

          <tbody>
            <% for (let producto of categoria.productos) { %>
            <tr>
              <td><%= producto.id %></td>

              <td>
                <% if (producto.imagen) { %>
                <img src="<%= producto.imagen %>" alt="<%= producto.modelo %>" width="60" height="60" class="rounded object-fit-cover" />
                <% } %>
              </td>

              <td><%= producto.marca %></td>
              <td><%= producto.modelo %></td>
              <td><%= producto.talle %></td>
              <td><%= producto.color %></td>
              <td><%= producto.jugador %></td>
              <td>$<%= producto.precio %></td>

              <td>
                <%= producto.activo ? "Activo" : "Inactivo" %>
              </td>

              <td>
                <a href="/productos/<%= producto.id %>/modificar" class="btn btn-primary btn-sm">
                    Modificar</a>
                    
                <% if (producto.activo) { %>
                <button type="button" class="btn btn-primary btn-sm btn-eliminar" id="<%= producto.id %>">
                  Eliminar
                </button>
                <% } else { %>
                <button type="button" class="btn btn-primary btn-sm btn-activar" id="<%= producto.id %>">
                  Activar
                </button>
                <% } %>
                
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
    <% } %>
  </main>

  <div class="modal fade" id="modalConfirmacion" tabindex="-1" aria-labelledby="tituloModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">

        <div class="modal-header">
          <h5 class="modal-title" id="tituloModal">
            Confirmar
          </h5>

          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>

        <div class="modal-body">
          <p id="mensajeModal">
            ¿Está seguro de realizar esta operación?
          </p>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancelar
          </button>

          <button type="button" class="btn btn-primary" id="btnConfirmar">
            Confirmar
          </button>
        </div>

      </div>
    </div>
  </div>

  <footer class="bg-body-tertiary text-center py-3 border-top">
    <small class="text-body-secondary">
      Alumnos: Lorenzo Braunstein &amp; Adrián López Da Silva
    </small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <script src="../Public/js/dashboard.js"></script>
</body>

</html>
<!doctype html>
<html lang="es" data-bs-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel de administración</title>
    <link rel="icon" href="/public/img/logo.jpg" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/public/css/styles.css" />
  </head>

  <body data-page="dashboard">
    <%- include("nav") %>

    <main class="container py-4">
      <h1 class="h3 mb-4">Panel de administración</h1>

      <section class="mb-5">
        <h2 class="h5 mb-3">Zapatillas</h2>

        <div class="table-responsive">
          <table class="table table-striped align-middle">
            <thead>
              <tr class="table-primary">
                <th>ID</th>
                <th>Imagen</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Talle</th>
                <th>Color</th>
                <th>Jugador</th>
                <th>Precio</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              <% for (let producto of zapatillas) { %>
              <tr>
                <td><%= producto.id %></td>
                <td>
                  <% if (producto.imagen) { %>
                  <img
                    src="<%= producto.imagen %>"
                    alt="<%= producto.modelo %>"
                    width="60"
                    height="60"
                    class="rounded object-fit-cover"
                  />
                  <% } %>
                </td>
                <td><%= producto.marca %></td>
                <td><%= producto.modelo %></td>
                <td><%= producto.talle %></td>
                <td><%= producto.color %></td>
                <td><%= producto.jugador %></td>
                <td>$<%= producto.precio %></td>
                <td><%= producto.activo ? "Activo" : "Inactivo" %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mb-5">
        <h2 class="h5 mb-3">Camisetas</h2>

        <div class="table-responsive">
          <table class="table table-striped align-middle">
            <thead>
              <tr class="table-primary">
                <th>ID</th>
                <th>Imagen</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Talle</th>
                <th>Color</th>
                <th>Jugador</th>
                <th>Precio</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              <% for (let producto of camisetas) { %>
              <tr>
                <td><%= producto.id %></td>
                <td>
                  <% if (producto.imagen) { %>
                  <img
                    src="<%= producto.imagen %>"
                    alt="<%= producto.modelo %>"
                    width="60"
                    height="60"
                    class="rounded object-fit-cover"
                  />
                  <% } %>
                </td>
                <td><%= producto.marca %></td>
                <td><%= producto.modelo %></td>
                <td><%= producto.talle %></td>
                <td><%= producto.color %></td>
                <td><%= producto.jugador %></td>
                <td>$<%= producto.precio %></td>
                <td><%= producto.activo ? "Activo" : "Inactivo" %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <footer class="bg-body-tertiary text-center py-3 border-top">
      <small class="text-body-secondary">
        Alumnos: Lorenzo Braunstein &amp; Adrián López Da Silva
      </small>
    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
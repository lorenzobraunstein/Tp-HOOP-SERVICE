<!doctype html>
<html lang="es" data-bs-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login Administradores</title>
    <link rel="icon" href="/public/img/logo.jpg" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/public/css/styles.css" />
  </head>

  <body data-page="login">
    <nav class="navbar navbar-expand-md bg-primary" data-bs-theme="dark">
      <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/usuarios/login">
          <img
            src="/public/img/logo.jpg"
            alt="Logo HOOP Service"
            width="40"
            height="40"
            class="rounded"
          />
          <span class="fw-semibold">HOOP SERVICE</span>
        </a>

        <div class="ms-auto d-flex align-items-center gap-2">
          <!-- history.back() en vez de un link fijo, porque el
               frontend corre en otro puerto y no lo queremos
               hardcodear acá -->
          <button type="button" class="btn btn-outline-light btn-sm" onclick="history.back()">
            Volver
          </button>
        </div>
      </div>
    </nav>

    <main class="bienvenida">
      <div class="bienvenida__card">
        <img
          src="/public/img/logo.jpg"
          alt="Logo de HOOP Service"
          width="120"
          height="120"
        />
        <h1 class="h3">Login de administradores</h1>
        <p class="text-body-secondary mb-0">
          Ingrese su email y contraseña para acceder.
        </p>

        <form id="form-login" class="w-100" action="/usuarios/login" method="post">
          <div class="mb-3 text-start">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control" required />
          </div>
          <div class="mb-3 text-start">
            <label for="contraseña" class="form-label">Contraseña</label>
            <input type="password" id="contraseña" name="contraseña" class="form-control" required />
          </div>

          <button type="submit" class="btn btn-primary w-100 mb-2">Ingresar</button>

          <!-- Lo pide la consigna: que los profes no tengan que
               tipear credenciales para probar la app -->
          <button type="button" class="btn btn-outline-primary w-100" id="btn-acceso-rapido">
            Acceso rápido
          </button>
        </form>
      </div>
    </main>

    <footer class="bg-body-tertiary text-center py-3 border-top">
      <small class="text-body-secondary">
        Alumnos: Lorenzo Braunstein &amp; Adrián López Da Silva
      </small>
    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script src="/public/js/login.js"></script>
  </body>
</html>

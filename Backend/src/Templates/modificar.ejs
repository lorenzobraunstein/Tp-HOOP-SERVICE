
<!doctype html>
<html lang="es" data-bs-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Modificar producto</title>
    <link rel="icon" href="/public/img/logo.jpg" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/public/css/styles.css" />
  </head>

  <body data-page="modificar">
    <%- include("nav") %>

    <main class="container py-4">
      <h1 class="h3 mb-4">Modificar producto</h1>

      <form
        id="form-modificar-producto"
        class="card p-4 shadow-sm"
        data-id="<%= producto.id %>"
      >
        <div class="row g-3">
          <div class="col-md-6">
            <label for="marca" class="form-label">Marca</label>
            <input
              type="text"
              class="form-control"
              id="marca"
              name="marca"
              value="<%= producto.marca %>"
              minlength="2"
              required
            />
          </div>

          <div class="col-md-6">
            <label for="modelo" class="form-label">Modelo</label>
            <input
              type="text"
              class="form-control"
              id="modelo"
              name="modelo"
              value="<%= producto.modelo %>"
              minlength="2"
              required
            />
          </div>

          <div class="col-md-6">
            <label for="talle" class="form-label">Talle</label>
            <input
              type="text"
              class="form-control"
              id="talle"
              name="talle"
              value="<%= producto.talle %>"
              required
            />
          </div>

          <div class="col-md-6">
            <label for="color" class="form-label">Color</label>
            <input
              type="text"
              class="form-control"
              id="color"
              name="color"
              value="<%= producto.color %>"
              minlength="2"
              required
            />
          </div>

          <div class="col-md-6">
            <label for="jugador" class="form-label">Jugador</label>
            <input
              type="text"
              class="form-control"
              id="jugador"
              name="jugador"
              value="<%= producto.jugador %>"
              minlength="2"
              required
            />
          </div>

          <div class="col-md-6">
            <label for="precio" class="form-label">Precio</label>
            <input
              type="number"
              class="form-control"
              id="precio"
              name="precio"
              value="<%= producto.precio %>"
              min="0.01"
              step="0.01"
              required
            />
          </div>

          <div class="col-md-6">
            <label for="tipo" class="form-label">Tipo de producto</label>
            <select class="form-select" id="tipo" name="tipo" required>
              <option
                value="zapatillas"
                <%= producto.tipo === "zapatillas" ? "selected" : "" %>
              >
                Zapatillas
              </option>
              <option
                value="camisetas"
                <%= producto.tipo === "camisetas" ? "selected" : "" %>
              >
                Camisetas
              </option>
            </select>
          </div>

          <div class="col-md-6">
            <label for="activo" class="form-label">Estado del producto</label>
            <select class="form-select" id="activo" name="activo" required>
              <option
                value="true"
                <%= producto.activo ? "selected" : "" %>
              >
                Activo
              </option>
              <option
                value="false"
                <%= !producto.activo ? "selected" : "" %>
              >
                Inactivo
              </option>
            </select>
          </div>

          <div class="col-md-6">
            <label for="imagen" class="form-label">Imagen del producto</label>
            <input
              type="file"
              class="form-control"
              id="imagen"
              name="imagen"
              accept="image/*"
            />
            <small class="form-text text-body-secondary">
              Seleccioná una imagen únicamente si querés reemplazar la actual.
            </small>
          </div>

          <div class="col-md-6">
            <label class="form-label">Imagen actual</label>
            <% if (producto.imagen) { %>
              <div>
                <img
                  src="<%= producto.imagen %>"
                  alt="Imagen actual del producto"
                  class="img-thumbnail"
                  style="max-width: 180px; max-height: 180px; object-fit: contain;"
                />
              </div>
            <% } else { %>
              <p class="text-body-secondary">Este producto no tiene imagen.</p>
            <% } %>
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
          <a href="/productos/dashboard" class="btn btn-secondary">
            Cancelar
          </a>

          <button type="submit" class="btn btn-primary">
            Guardar cambios
          </button>
        </div>
      </form>
    </main>

    <footer class="bg-body-tertiary text-center py-3 border-top">
      <small class="text-body-secondary">
        Alumnos: Lorenzo Braunstein &amp; Adrián López Da Silva
      </small>
    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script src="/public/js/modificar.js"></script>
  </body>
</html>
